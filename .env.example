# Fill in a key for whichever provider(s) you'll use -- leave the rest blank.
# Which provider is ACTIVE, and which model each one uses, is chosen live from
# the review UI (the provider + model dropdowns in the project header), not
# here. That live selection lives in .design/settings.yaml (gitignored,
# app-managed) instead, and takes effect immediately, no restart needed. See
# the README's "Live model providers" section.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Advanced: a real process env var (set via your hosting platform, not this
# file) still overrides the UI selection -- e.g. to pin a deployment to one
# provider/model regardless of what anyone toggles in the UI. Uncomment and
# set via your platform's env config, not by editing .env:
# DESIGN_PIPELINE_PROVIDER=openai
# OPENAI_MODEL=gpt-5.4-nano

# Optional controls. Keys remain server-side and are never exposed in the review UI.
DESIGN_PIPELINE_MAX_OUTPUT_TOKENS=16000
DESIGN_PIPELINE_TIMEOUT_SECONDS=300
DESIGN_PIPELINE_MAX_TOOL_ITERATIONS=20

# Optional: persist agent-rendered Mermaid diagrams to a Mermaid Chart
# account (requires the `mermaid` extra: pip install ".[mermaid]"). The
# render/validate tool itself needs no key at all; this only enables the
# extra step of saving diagrams under your Mermaid Chart account.
MERMAID_API_KEY=
