# Choose exactly one provider. Keep `stub` for deterministic, offline fixtures.
DESIGN_PIPELINE_PROVIDER=stub

# OpenAI (used when DESIGN_PIPELINE_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic / Claude (used when DESIGN_PIPELINE_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Google Gemini (used when DESIGN_PIPELINE_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional controls. Keys remain server-side and are never exposed in the review UI.
DESIGN_PIPELINE_MAX_OUTPUT_TOKENS=16000
DESIGN_PIPELINE_TIMEOUT_SECONDS=300
DESIGN_PIPELINE_MAX_TOOL_ITERATIONS=20

# Optional: persist agent-rendered Mermaid diagrams to a Mermaid Chart
# account (requires the `mermaid` extra: pip install ".[mermaid]"). The
# render/validate tool itself needs no key at all; this only enables the
# extra step of saving diagrams under your Mermaid Chart account.
MERMAID_API_KEY=
