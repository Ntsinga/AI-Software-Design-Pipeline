# Choose exactly one provider. Keep `stub` for deterministic, offline fixtures.
DESIGN_PIPELINE_PROVIDER=stub

# OpenAI (used when DESIGN_PIPELINE_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic / Claude (used when DESIGN_PIPELINE_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional controls. Keys remain server-side and are never exposed in the review UI.
DESIGN_PIPELINE_MAX_OUTPUT_TOKENS=3500
DESIGN_PIPELINE_TIMEOUT_SECONDS=60
